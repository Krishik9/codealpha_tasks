import spacy

class ChatBot:
    def __init__(self):
        # Load the spaCy language model
        self.nlp = spacy.load("en_core_web_sm")
        # Predefined responses
        self.responses = {
            "greeting": ["Hi there! How can I help you today?", "Hello! What's on your mind?"],
            "goodbye": ["Goodbye! Have a great day!", "See you later!"],
            "thank_you": ["You're welcome!", "No problem, happy to help!"],
            "default": ["I'm sorry, I don't quite understand.", "Can you rephrase that?"],
        }
    
    def classify_intent(self, user_input):
        """Classify the user's intent based on their input."""
        doc = self.nlp(user_input.lower())
        if any(token.lemma_ in ["hello", "hi", "hey"] for token in doc):
            return "greeting"
        elif any(token.lemma_ in ["bye", "goodbye", "see you"] for token in doc):
            return "goodbye"
        elif any(token.lemma_ in ["thank", "thanks"] for token in doc):
            return "thank_you"
        else:
            return "default"
    
    def get_response(self, intent):
        """Retrieve a response based on the user's intent."""
        return self.responses.get(intent, self.responses["default"])

    def chat(self):
        """Start the chatbot conversation."""
        print("ChatBot: Hi! I'm your friendly chatbot. Type 'exit' to end the conversation.\n")
        while True:
            user_input = input("You: ").strip()
            if user_input.lower() in ["exit", "quit", "bye"]:
                print("ChatBot: Goodbye! Have a nice day!")
                break
            intent = self.classify_intent(user_input)
            response = self.get_response(intent)
            print(f"ChatBot: {response[0]}")

# Run the chatbot
if __name__ == "__main__":
    bot = ChatBot()
    bot.chat()
